# ==============================================================================
# my_neo-agent Environment Configuration
# Copy this file to .env: cp .env.example .env (or copy .env.example .env in CMD/PowerShell)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ollama Server Configuration
# ------------------------------------------------------------------------------
# Base URL for the local or remote Ollama instance (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Primary Model used for general orchestration and coding tasks
# Recommended options:
#   - qwen2.5-coder:7b      (Fast, high-performance coding model - 8GB VRAM/RAM)
#   - qwen2.5-coder:14b     (Great reasoning & code generation - 16GB VRAM/RAM)
#   - qwen2.5-coder:32b     (State of the art local coding - 24GB+ VRAM)
#   - deepseek-r1:8b        (Strong step-by-step reasoning)
#   - gemma4:31b-cloud      (Cloud / High-parameter model)
PRIMARY_MODEL=qwen2.5-coder:7b

# Vision Model used by Eagle Agent for screen debugging and image analysis
# Recommended options:
#   - llama3.2-vision:11b   (High accuracy multimodal)
#   - llava:7b              (Standard lightweight vision model)
#   - minicpm-v             (Efficient vision model)
#   - gemma4:12b            (Default fallback)
VISION_MODEL=llava:7b

# Fallback models if primary model is unavailable or encounters errors
# Comma-separated or managed in config.py
# Example: qwen2.5-coder:7b,gemma4,llama3.1:8b

# ------------------------------------------------------------------------------
# 2. Workspace & File System Paths
# ------------------------------------------------------------------------------
# Root workspace directory where generated files and projects will be saved
# Defaults to the project directory if left blank
WORKSPACE_PATH=.

# Storage directory for databases, logs, and artifacts (default: ./data)
DATA_DIR=./data

# LangGraph checkpoints SQLite database path
CHECKPOINT_DB_PATH=./data/checkpoints.db

# Chat history SQLite database path
CHAT_HISTORY_DB_PATH=./data/chat_history.db

# Directory for generated Herald slide decks (.html, .pptx)
PRESENTATIONS_DIR=./data/presentations

# Directory for Eagle analysis reports and debug logs
ANALYSIS_OUTPUT_DIR=./data/analysis_output

# ------------------------------------------------------------------------------
# 3. Web Server & UI Settings
# ------------------------------------------------------------------------------
PORT=8000
HOST=127.0.0.1
